# 默认忽略所有
*

# 保留根目录文件
!.gitignore
!README.md
!README.zh.md
!CLAUDE.md
!USER_MANUAL.md
!USER_MANUAL.zh.md
!URL_20260503.md

# 保留插件清单
!.claude-plugin/
!.claude-plugin/**

# 保留脚本
!scripts/
!scripts/**

# 保留技能目录
!skills/
!skills/**/
!skills/**/*

# 保留共享包
!packages/
!packages/**/
!packages/**/*

# 保留截图
!screenshots/
!screenshots/**/*

# 保留自动化同步系统
!.auto-sync/
!.auto-sync/**/*

# 排除构建产物
node_modules/
.DS_Store
*.pyc
__pycache__/
*.log

# 本地插件配置
.claude/*.local.md
